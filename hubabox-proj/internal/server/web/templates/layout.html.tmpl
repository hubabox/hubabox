{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{{if .Title}}{{.Title}} — {{end}}hubaBox</title>
	<link rel="stylesheet" href="/static/css/app.css">
	<script src="https://unpkg.com/htmx.org@2.0.4"></script>
	<script src="/static/js/hub.js" defer></script>
</head>
<body>
	<header class="top">
		<h1 class="brand">hubaBox</h1>
		<p class="tag">Offline file hub</p>
	</header>
	<main class="main">
		{{if eq .Content "setup"}}{{template "setup" .}}{{end}}
		{{if eq .Content "login"}}{{template "login" .}}{{end}}
		{{if eq .Content "files"}}{{template "files" .}}{{end}}
		{{if eq .Content "library_unlock"}}{{template "library_unlock" .}}{{end}}
		{{if eq .Content "library_pick_nick"}}{{template "library_pick_nick" .}}{{end}}
		{{if eq .Content "library_list"}}{{template "library_list" .}}{{end}}
	</main>
	{{if eq .Content "library_list"}}<script src="/static/js/library-chat.js" defer></script>{{end}}
</body>
</html>
{{end}}
