{{define "library_unlock"}}
<section class="card">
	<h2>Library</h2>
	<p class="muted">Read-only access to files on this hub. Prefer the <strong>invite link</strong> from the admin (one tap). Or paste the access code below.</p>
	{{if eq .Error "badtoken"}}<p class="err">That code did not match.</p>{{end}}
	{{if eq .Error "missing"}}<p class="err">Use the full invite link (it ends with <code>?k=…</code>) or paste the code.</p>{{end}}
	{{if eq .Error "badform"}}<p class="err">Invalid form.</p>{{end}}
	<form method="post" action="/library/unlock" class="stack">
		<label>Access code <input type="text" name="token" class="mono" required autocomplete="off" spellcheck="false" autocapitalize="off"></label>
		<button type="submit">Continue</button>
	</form>
</section>
{{end}}

{{define "library_list"}}
<section class="card">
	<div class="row">
		<h2>Library</h2>
		<form method="post" action="/library/logout" class="inline"><button type="submit" class="secondary">Leave library</button></form>
	</div>
	<p class="muted">Download only — no uploads from here.</p>
</section>
<section class="card">
	<h3>Files</h3>
	{{if .Files}}
	<ul class="filelist">
		{{range .Files}}
		<li><a href="{{.URL}}">{{.Name}}</a></li>
		{{end}}
	</ul>
	{{else}}
	<p class="muted">No files yet.</p>
	{{end}}
</section>
{{end}}
