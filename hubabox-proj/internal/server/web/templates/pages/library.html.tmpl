{{define "library_unlock"}}
<section class="card">
	<h2>Library</h2>
	<p class="muted">Read-only access to files on this hub. Prefer the <strong>invite link</strong> from the admin (one tap). Or type the full access code, or only the <strong>last 6 characters</strong> (hex digits from the code).</p>
	{{if eq .Error "badtoken"}}<p class="err">That code did not match.</p>{{end}}
	{{if eq .Error "missing"}}<p class="err">Use the invite link (<code>?k=…</code>), paste the full code, or enter the last 6 characters.</p>{{end}}
	{{if eq .Error "badform"}}<p class="err">Invalid form.</p>{{end}}
	{{if eq .Error "badnick"}}<p class="err">Choose a display name (1–32 letters or numbers; spaces, hyphens, and a few punctuation marks allowed).</p>{{end}}
	<form method="post" action="/library/unlock" class="stack stack--narrow">
		<label>Display name <input type="text" name="display_name" required autocomplete="username" maxlength="64" placeholder="How you appear in chat"></label>
		<label>Access code <input type="text" name="token" class="mono" required autocomplete="off" spellcheck="false" autocapitalize="off" maxlength="128" placeholder="full code or last 6 characters"></label>
		<button type="submit">Continue</button>
	</form>
</section>
{{end}}

{{define "library_pick_nick"}}
<section class="card">
	<h2>Library</h2>
	<p class="muted">Choose how your name appears in the library chat. Anyone with the library code can join; this name is only for display.</p>
	{{if eq .Error "badnick"}}<p class="err">That name is not allowed. Use 1–32 letters or numbers; spaces, hyphens, underscores, periods, commas, and apostrophes are OK.</p>{{end}}
	{{if eq .Error "badform"}}<p class="err">Invalid form.</p>{{end}}
	<form method="post" action="/library/set-name" class="stack stack--narrow">
		<label>Display name <input type="text" name="display_name" required autocomplete="username" maxlength="64" autofocus></label>
		<button type="submit">Continue</button>
	</form>
</section>
{{end}}

{{define "library_chat_ul"}}
<ul class="lib-chat-msgs">
	{{range .LibraryChatMsgs}}
	<li class="lib-chat-li">
		<div class="lib-chat-meta"><span class="lib-chat-author">{{.Author}}</span> <span class="muted">{{.Time}}</span></div>
		{{if .Body}}<div class="lib-chat-body">{{.Body}}</div>{{end}}
		{{if .AudioURL}}<audio class="lib-chat-audio" controls preload="metadata">{{if .AudioM4AFallback}}<source src="{{.AudioURL}}" type="audio/mp4"><source src="{{.AudioURL}}" type="audio/3gpp"><source src="{{.AudioURL}}" type="audio/x-m4a">{{else}}<source src="{{.AudioURL}}"{{if .AudioMIME}} type="{{.AudioMIME}}"{{end}}>{{end}}</audio>{{end}}
	</li>
	{{else}}
	<li class="muted lib-chat-empty">No messages yet — say hello.</li>
	{{end}}
</ul>
{{end}}

{{define "library_list"}}
<section class="card">
	<div class="row">
		<h2>Library</h2>
		<form method="post" action="/library/logout" class="inline"><button type="submit" class="secondary">Leave library</button></form>
	</div>
	<p class="muted">Signed in as <strong>{{.LibraryGuestNick}}</strong> — download only for files; chat is for guests on this hub.</p>
</section>
<section class="card lib-chat">
	<h3>Chat</h3>
	<p class="muted">Scroll for older lines; the list updates automatically about every 8 seconds while this tab is open.</p>
	{{if .LibraryChatFlash}}<p class="err">{{.LibraryChatFlash}}</p>{{end}}
	<div id="lib-chat-msgs-host" class="lib-chat-scroll-host">
		{{template "library_chat_ul" .}}
	</div>
	<form id="libChatForm" method="post" action="/library/chat/post" enctype="multipart/form-data" class="stack lib-chat-form">
		<div class="lib-chat-message-row">
			<label class="lib-chat-message-field">
				<span class="lib-chat-message-caption">Message</span>
				<textarea name="body" rows="2" maxlength="8000" id="libChatBody" placeholder="Type here… (optional if you only send a voice clip)"></textarea>
			</label>
			<button type="submit" id="libChatSend" class="lib-chat-send" disabled>Send</button>
		</div>
		<div class="lib-voice-panel">
			<input type="file" name="audio" id="libVoiceInput" accept="audio/*" class="sr-only">
			<label for="libVoiceInput" class="lib-voice-upload">Upload clip</label>
			<button type="button" id="libVoiceToggle" class="secondary lib-voice-toggle" aria-pressed="false">Record</button>
			<span id="libVoiceStatus" class="lib-voice-status muted" role="status"></span>
		</div>
	</form>
</section>
<section class="card">
	<h3>Files</h3>
	{{if .LibraryWhatsNewStrip}}
	<p class="lib-whats-new muted" role="status">{{.LibraryWhatsNewStrip}}</p>
	{{end}}
	<div class="file-browser">
		<div class="file-browser__filters">
			<label class="filter-field">
				<span class="muted">Search name</span>
				<input type="search" class="file-filter" placeholder="Substring in filename…" autocomplete="off">
			</label>
			<label class="filter-field">
				<span class="muted">Type</span>
				<select class="file-kind-filter" aria-label="Filter by file type">
					<option value="">All types</option>
					<option value="image">Images</option>
					<option value="video">Video</option>
					<option value="audio">Audio</option>
					<option value="pdf">PDF</option>
					<option value="archive">Archives</option>
					<option value="documents">Documents (Word / Excel / slides)</option>
					<option value="code">Text &amp; code</option>
					<option value="exe">Apps</option>
					<option value="other">Other</option>
				</select>
			</label>
		</div>
		<p class="file-filter-summary muted" role="status" aria-live="polite" hidden></p>
		{{if .Files}}
		<div class="file-browser-scroll">
			<ul class="filelist">
				{{range .Files}}
				<li data-name="{{.Name}}" data-kind="{{.Kind}}"{{if .IsNew}} class="filelist-li--new"{{end}}>
					<div class="file-cell">
						<div class="file-cell__primary">
							<span class="file-kind file-kind--{{.Kind}}" title="{{.KindLabel}}">{{.KindLabel}}</span>
							<a class="file-cell__name" href="{{.URL}}" title="{{.Name}}">{{.Name}}</a>
						</div>
						<div class="file-cell__actions">
							{{if .PreviewURL}}<a href="{{.PreviewURL}}" class="file-action file-action--preview" target="_blank" rel="noopener">Preview</a>{{end}}
							{{if .InsightURL}}<button type="button" class="file-action file-action--details" data-insight-url="{{.InsightURL}}">Details</button>{{end}}
						</div>
					</div>
					<div class="file-meta">
						<span>{{.SizeHuman}}</span>
						<span class="muted">{{.Age}}</span>
					</div>
				</li>
				{{end}}
			</ul>
		</div>
		{{else}}
		<p class="muted">No files yet.</p>
		{{end}}
	</div>
</section>

<div id="hubFileInsightModal" class="file-insight-modal" hidden aria-hidden="true">
	<div class="file-insight-modal__backdrop" data-close-insight-modal tabindex="-1"></div>
	<div class="file-insight-modal__panel" role="dialog" aria-modal="true" aria-labelledby="hubFileInsightModalTitle">
		<header class="file-insight-modal__head">
			<h2 id="hubFileInsightModalTitle" class="file-insight-modal__title">File details</h2>
			<button type="button" class="file-insight-modal__close secondary" data-close-insight-modal aria-label="Close">Close</button>
		</header>
		<div class="file-insight-modal__body"></div>
	</div>
</div>
{{end}}
