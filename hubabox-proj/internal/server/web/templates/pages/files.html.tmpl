{{define "files"}}
<section class="card">
	<div class="row">
		<h2>Files</h2>
		<form method="post" action="/logout" class="inline"><button type="submit" class="secondary">Sign out</button></form>
	</div>
	{{if .Flash}}<p class="flash">{{.Flash}}</p>{{end}}
	<p class="muted">Admin: upload files here; guests use the <strong>library</strong> below (read-only).</p>
</section>

<section class="card hub-insight-card">
	<h3>Hub storage</h3>
	<dl class="hub-insight-dl">
		<div class="hub-insight-row">
			<dt class="muted">Data directory</dt>
			<dd><code class="hub-insight-path">{{.HubDataDirAbs}}</code></dd>
		</div>
		<div class="hub-insight-row">
			<dt class="muted">Files in hub</dt>
			<dd>{{.HubFilesCount}} files ({{.HubFilesBytesHuman}} total)</dd>
		</div>
		<div class="hub-insight-row">
			<dt class="muted">Database</dt>
			<dd><code>hubabox.db</code> — {{.HubDBSizeHuman}}</dd>
		</div>
	</dl>
</section>

<section class="card">
	<h3>This hub on your network</h3>
	{{if .BindLocalhostWarn}}<p class="err">{{.BindLocalhostWarn}}</p>{{end}}
	{{if .LANIPs}}
	<p class="muted">On the <strong>same Wi‑Fi / LAN</strong>, open these links from a phone or another computer (port <strong>{{.ListenPort}}</strong>):</p>
	<ul class="lan-url-list muted">
		{{range .LANIPs}}
		<li>
			<code>{{.}}</code> —
			<a href="http://{{.}}:{{$.ListenPort}}/login">login</a>,
			<a href="http://{{.}}:{{$.ListenPort}}/files">files</a>{{if $.LibraryEnabled}},
			<a href="http://{{.}}:{{$.ListenPort}}/library">library</a>{{end}}
		</li>
		{{end}}
	</ul>
	{{else}}
	<p class="muted">No private LAN IPv4 was auto-detected (unusual interfaces only, or permissions). Find this machine’s address in OS network settings or <code>ip a</code>, then use <code>http://THAT_IP:{{.ListenPort}}/files</code>.</p>
	{{end}}
</section>

<section class="card">
	<h3>USB / import folder</h3>
	<p class="muted">Enter a <strong>USB mount</strong> or any <strong>folder to watch</strong>. The hub <strong>copies</strong> files in (the source folder is left as-is). Only <strong>top-level</strong> names; dotfiles and <code>Thumbs.db</code> are skipped. The path must not be the hub’s <code>files/</code> tree or inside it.</p>
	{{if .ImportEnvOverride}}
	<p class="muted">This process was started with <code>-import</code> or <code>HUBABOX_IMPORT</code>, which <strong>overrides</strong> the path below. Remove that flag or env var to use the saved path from the UI.</p>
	{{end}}
	<form method="post" action="/files/import/config" class="stack-row import-path-form">
		<label class="import-path-label">
			<span class="muted">Watch folder</span>
			<input type="text" name="import_path" value="{{.ImportWatchDirSaved}}" placeholder="/media/you/USBNAME" autocomplete="off">
		</label>
		<button type="submit">Save path</button>
	</form>
	<form method="post" action="/files/import/config" class="inline">
		<input type="hidden" name="import_path" value="">
		<button type="submit" class="secondary">Clear saved path</button>
	</form>
	{{if .ImportDir}}
	<p class="muted">Currently watching <code>{{.ImportDir}}</code>.</p>
	<form method="post" action="/files/import/auto" class="stack">
		<label class="stack-row import-auto-label">
			<input type="checkbox" name="import_auto_copy" value="1" {{if .ImportAutoCopy}}checked{{end}}>
			<span>Automatically copy <strong>every</strong> new file in the watch folder (off by default — better for large USB sticks)</span>
		</label>
		<button type="submit">Save auto-copy setting</button>
	</form>
	<h4>Import from this folder</h4>
	<p class="muted">Tick the files you want, then import. If the same filename already exists in the hub, a numeric suffix is added (same as uploads).</p>
	{{if .ImportListErr}}<p class="err">Could not list import folder: {{.ImportListErr}}</p>{{end}}
	{{if .ImportListTruncated}}<p class="muted">List shows the first 500 top-level names only.</p>{{end}}
	{{if .ImportListErr}}
	{{else if .ImportEntries}}
	<form method="post" action="/files/import/pick" id="importPickForm" class="stack">
		<p class="stack-row import-pick-toolbar">
			<button type="button" class="secondary" id="importSelectEligible">Select all importable</button>
			<button type="button" class="secondary" id="importClearEligible">Clear importable</button>
		</p>
		<div class="import-pick-scroll">
			<table class="import-pick-table">
				<thead>
					<tr><th></th><th>Name</th><th>Size</th><th></th></tr>
				</thead>
				<tbody>
					{{range .ImportEntries}}
					<tr>
						<td>
							{{if .Eligible}}
							<input type="checkbox" name="import_name" value="{{.Name}}" class="import-pick-cb" data-eligible="1">
							{{else}}
							<input type="checkbox" disabled title="Not importable">
							{{end}}
						</td>
						<td><code>{{.Name}}</code></td>
						<td>{{.SizeHuman}}</td>
						<td class="muted">{{if .Eligible}}ready{{else}}{{.SkipReason}}{{end}}</td>
					</tr>
					{{end}}
				</tbody>
			</table>
		</div>
		<button type="submit">Import selected</button>
	</form>
	<script>
	(function () {
		var all = document.getElementById("importSelectEligible");
		var clr = document.getElementById("importClearEligible");
		if (!all || !clr) return;
		function boxes() {
			return document.querySelectorAll("#importPickForm input.import-pick-cb[data-eligible=\"1\"]");
		}
		all.addEventListener("click", function () {
			boxes().forEach(function (c) { c.checked = true; });
		});
		clr.addEventListener("click", function () {
			boxes().forEach(function (c) { c.checked = false; });
		});
	})();
	</script>
	{{else}}
	<p class="muted">No top-level items in this folder (or it is empty).</p>
	{{end}}
	<p class="muted">Tip: clear the import folder after copying to avoid pulling the same names again.</p>
	{{if .ImportLastAt}}<p class="muted">Last import run: <strong>{{.ImportLastAt}}</strong> — copied {{.ImportLastImported}}, skipped {{.ImportLastSkipped}}.</p>{{end}}
	{{if .ImportLastErr}}<p class="err">Last error: {{.ImportLastErr}}</p>{{end}}
	<form method="post" action="/files/import/scan">
		<button type="submit" class="secondary">Import entire folder now</button>
	</form>
	{{else}}
	<p class="muted">Nothing is being watched yet. Enter a path above and click <strong>Save path</strong>, or start the server with <code>-import</code> / <code>HUBABOX_IMPORT</code> for an ops override.</p>
	{{end}}
</section>

<section class="card">
	<h3>Public library (read-only)</h3>
	<p class="muted">Guests: <strong>invite link</strong> or <strong>code</strong> on <code>/library</code>. Open <code>/files</code> using the <strong>host or IP guests should use</strong> (your LAN address, not <code>localhost</code>, when sharing to phones).</p>
	{{if .LibraryEnabled}}
	{{if .LibraryInviteOrigin}}<p class="muted"><strong>Copy invite link</strong> uses <code>{{.LibraryInviteOrigin}}</code>. Set <code>HUBABOX_PUBLIC_ORIGIN</code> or <code>-public-origin</code> to pin the base URL; otherwise the hub picks your LAN IP, <code>{{.Hostname}}.local</code>, or the host you used to open this page.</p>{{end}}
	<p class="stack-row">
		<a class="btn" target="_blank" rel="noopener" href="/library/join?k={{.LibraryToken}}">Open library (this device)</a>
		<button type="button" class="secondary" id="copyLibInvite" data-invite-token="{{.LibraryToken}}" data-invite-origin="{{.LibraryInviteOrigin}}">Copy invite link</button>
	</p>
	<p class="muted">Manual entry (optional):</p>
	<pre class="codeblock">{{.LibraryToken}}</pre>
	{{if .MDNSEnabled}}
	<p class="muted">Bonjour lists <code>{{.MDNSInstance}}</code> on <code>_http._tcp</code> for discovery—that label is often <strong>not</strong> a working URL. Try <code>http://{{.Hostname}}.local:{{.ListenPort}}/library</code>, <code>http://{{.Hostname}}:{{.ListenPort}}/library</code>, or a LAN IP from the list above.</p>
	{{else}}
	<p class="muted">mDNS is off—shared links should use this machine’s <strong>LAN IP</strong> and port <code>{{.ListenPort}}</code>.</p>
	{{end}}
	<script>
	(function () {
		var btn = document.getElementById("copyLibInvite");
		if (!btn) return;
		btn.addEventListener("click", function () {
			var tok = btn.getAttribute("data-invite-token") || "";
			var base = (btn.getAttribute("data-invite-origin") || "").trim().replace(/\/$/, "");
			if (!base) {
				base = window.location.origin;
			}
			var u = base + "/library/join?k=" + encodeURIComponent(tok);
			function done(ok) {
				btn.textContent = ok ? "Copied!" : "Copy failed";
				setTimeout(function () { btn.textContent = "Copy invite link"; }, 2000);
			}
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(u).then(function () { done(true); }).catch(function () { window.prompt("Copy this link:", u); done(false); });
			} else {
				window.prompt("Copy this link:", u);
				done(true);
			}
		});
	})();
	</script>
	<h4 class="lib-admin-h4">Guest chat retention</h4>
	<p class="muted">Messages older than this many <strong>days</strong> are removed automatically (including voice clips). <strong>Disable library</strong> below clears all chat at once.</p>
	<form method="post" action="/files/library/chat-retention" class="stack-row lib-retention-form">
		<label class="muted lib-retention-label">
			<span>Days to keep</span>
			<input type="number" name="days" min="1" max="365" step="1" value="{{.LibraryChatRetentionDays}}" required>
		</label>
		<button type="submit" class="secondary">Apply</button>
	</form>
	<form method="post" action="/files/library/disable" class="inline">
		<button type="submit" class="secondary">Disable library</button>
	</form>
	{{else}}
	<form method="post" action="/files/library/enable">
		<button type="submit">Enable library &amp; generate code</button>
	</form>
	{{end}}
</section>

<section class="card">
	<h3>Upload</h3>
	<div class="dropzone" data-upload-url="/files/upload" aria-label="Drop files to upload">
		<p class="dropzone__hint"><strong>Drop files here</strong> or pick below — multiple files OK.</p>
	</div>
	<form method="post" action="/files/upload" enctype="multipart/form-data" class="stack">
		<label>Files <input type="file" name="files" multiple></label>
		<label class="muted">Folder upload <input type="file" name="files" multiple webkitdirectory directory></label>
		<p class="muted upload-hint">Nested paths are stored under the hub root (e.g. <code>photos/2024/a.jpg</code>). <code>..</code> and absolute paths are rejected.</p>
		<button type="submit">Upload</button>
	</form>
</section>

<section class="card">
	<h3>On this hub</h3>
	<div class="file-browser">
		<div class="file-browser__filters">
			<label class="filter-field">
				<span class="muted">Search name</span>
				<input type="search" class="file-filter" placeholder="Substring in filename…" autocomplete="off">
			</label>
			<label class="filter-field">
				<span class="muted">Type</span>
				<select class="file-kind-filter" aria-label="Filter by file type">
					<option value="">All types</option>
					<option value="image">Images</option>
					<option value="video">Video</option>
					<option value="audio">Audio</option>
					<option value="pdf">PDF</option>
					<option value="archive">Archives</option>
					<option value="documents">Documents (Word / Excel / slides)</option>
					<option value="code">Text &amp; code</option>
					<option value="exe">Apps</option>
					<option value="other">Other</option>
				</select>
			</label>
		</div>
		<p class="file-filter-summary muted" role="status" aria-live="polite" hidden></p>
		{{if .Files}}
		<form method="post" action="/files/delete" id="hubFilesBulkDeleteForm" class="file-delete-bulk-form">
			<p class="file-delete-toolbar stack-row">
				<button type="button" class="secondary" id="hubFilesSelectVisible">Select visible</button>
				<button type="button" class="secondary" id="hubFilesClearSelection">Clear selection</button>
				<button type="submit" class="danger secondary">Delete selected</button>
			</p>
			<div class="file-browser-scroll">
				<ul class="filelist">
					{{range .Files}}
					<li data-name="{{.Name}}" data-kind="{{.Kind}}"{{if .IsNew}} class="filelist-li--new"{{end}}>
						<label class="file-pick" title="Select for delete">
							<input type="checkbox" name="name" value="{{.Name}}" class="file-delete-cb">
						</label>
						<div class="file-cell">
							<div class="file-cell__primary">
								<span class="file-kind file-kind--{{.Kind}}" title="{{.KindLabel}}">{{.KindLabel}}</span>
								<a class="file-cell__name" href="{{.URL}}" title="{{.Name}}">{{.Name}}</a>
							</div>
							<div class="file-cell__actions">
								{{if .PreviewURL}}<a href="{{.PreviewURL}}" class="file-action file-action--preview" target="_blank" rel="noopener">Preview</a>{{end}}
								{{if .InsightURL}}<button type="button" class="file-action file-action--details" data-insight-url="{{.InsightURL}}">Details</button>{{end}}
							</div>
						</div>
						<div class="file-meta">
							<span>{{.SizeHuman}}</span>
							<span class="muted">{{.Age}}</span>
						</div>
					</li>
					{{end}}
				</ul>
			</div>
		</form>
		{{else}}
		<p class="muted">No files yet.</p>
		{{end}}
	</div>
</section>

<div id="hubFileInsightModal" class="file-insight-modal" hidden aria-hidden="true">
	<div class="file-insight-modal__backdrop" data-close-insight-modal tabindex="-1"></div>
	<div class="file-insight-modal__panel" role="dialog" aria-modal="true" aria-labelledby="hubFileInsightModalTitle">
		<header class="file-insight-modal__head">
			<h2 id="hubFileInsightModalTitle" class="file-insight-modal__title">File details</h2>
			<button type="button" class="file-insight-modal__close secondary" data-close-insight-modal aria-label="Close">Close</button>
		</header>
		<div class="file-insight-modal__body"></div>
	</div>
</div>
{{end}}
